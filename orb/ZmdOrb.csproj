<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net6.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- 托盘图标用 WinForms 的 NotifyIcon（M4）；WPF 与 WinForms 可以共存 -->
    <UseWindowsForms>true</UseWindowsForms>
    <!-- WinForms 只是为了托盘的 NotifyIcon；DPI 感知继续由 app.manifest 交给 WPF 管，
         所以不接受 WFAC010 让我们改用 Application.SetHighDpiMode 的建议 -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
    <Nullable>enable</Nullable>
    <LangVersion>10.0</LangVersion>
    <AssemblyName>zmd-orb</AssemblyName>
    <RootNamespace>ZmdOrb</RootNamespace>
    <ApplicationIcon>icon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- 只有中文一种语言，别让 SDK 生成一堆卫星资源目录 -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <AssemblyTitle>终末地加速球</AssemblyTitle>
    <Product>终末地加速球</Product>
    <Version>0.2.0</Version>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <!-- 采集端：CI 会先把 PyInstaller 产物放到 orb/backend.exe，随发布目录一起落地 -->
  <ItemGroup>
    <None Include="backend.exe" Condition="Exists('backend.exe')"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>