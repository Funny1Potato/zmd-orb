<Window x:Class="ZmdOrb.PanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="终末地加速球 · 任务管理器"
        Width="900" Height="780" MinWidth="720" MinHeight="480"
        WindowStyle="None" ResizeMode="CanResize" Background="#f3f3f0"
        WindowStartupLocation="CenterScreen" ShowActivated="True"
        FontFamily="Segoe UI, Microsoft YaHei" TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True" SnapsToDevicePixels="True">

  <!-- 面板不透明，不需要透明层：文字走硬件加速更清晰。顶栏当标题栏用（可拖拽/双击最大化），
       里面的按钮要显式声明在 chrome 里可点。 -->
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="38" ResizeBorderThickness="6" CornerRadius="0"
                        GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
  </shell:WindowChrome.WindowChrome>

  <Window.Resources>
    <Style x:Key="HeadBtn" TargetType="Button">
      <Setter Property="Foreground" Value="#6a6a64"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Height" Value="24"/>
      <Setter Property="MinWidth" Value="26"/>
      <Setter Property="Padding" Value="8,0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="4"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bg" Property="Background" Value="#dededa"/>
                <Setter Property="Foreground" Value="#3a3a36"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="ActBtn" TargetType="Button">
      <Setter Property="Height" Value="32"/>
      <Setter Property="Padding" Value="14,0"/>
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="Foreground" Value="#3f3f3a"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bg" Background="#ffffff" BorderBrush="#dcdcd6" BorderThickness="1"
                    CornerRadius="6" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bg" Property="Background" Value="#f6f6f2"/>
                <Setter TargetName="bg" Property="BorderBrush" Value="#c6c6bf"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="bg" Property="Opacity" Value="0.45"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="CardKey" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Foreground" Value="#8b8b84"/>
      <Setter Property="Margin" Value="0,0,0,6"/>
    </Style>

    <Style x:Key="CardVal" TargetType="TextBlock">
      <Setter Property="FontSize" Value="20"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="#3f3f3a"/>
    </Style>
  </Window.Resources>

  <Border BorderBrush="#dcdcd6" BorderThickness="1">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="38"/>
        <RowDefinition Height="2"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <Border Grid.Row="0" Background="#e9e9e5" BorderBrush="#dcdcd6" BorderThickness="0,0,0,1">
        <Grid>
          <TextBlock Text="终末地加速球 · 任务管理器" VerticalAlignment="Center" Margin="14,0,0,0"
                     FontSize="13" FontWeight="SemiBold" Foreground="#4a4a46"/>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"
                      Margin="0,0,6,0" shell:WindowChrome.IsHitTestVisibleInChrome="True">
            <Button x:Name="ToBall" Content="收起到球" Style="{StaticResource HeadBtn}" Click="ToBall_Click"/>
            <Button x:Name="QuitBtn" Content="✕" Style="{StaticResource HeadBtn}" Click="Quit_Click"/>
          </StackPanel>
        </Grid>
      </Border>

      <Rectangle Grid.Row="1" Fill="#ffe23d"/>

      <Grid Grid.Row="2" Margin="16">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">

          <!-- 三个档位：轻度免提权；深度/全部要管理员，点了才会弹一次 UAC -->
          <StackPanel Orientation="Horizontal">
            <Button x:Name="BtnL1" Content="轻度整理" Style="{StaticResource ActBtn}" Click="CleanL1_Click"/>
            <Button x:Name="BtnL2" Content="深度整理" Style="{StaticResource ActBtn}" Margin="8,0,0,0"
                    Click="CleanL2_Click"/>
            <Button x:Name="BtnL3" Content="全部整理" Style="{StaticResource ActBtn}" Margin="8,0,0,0"
                    Click="CleanL3_Click"/>
            <TextBlock x:Name="adminHint" VerticalAlignment="Center" Margin="12,0,0,0" FontSize="11.5"
                       Foreground="#8b8b84"/>
          </StackPanel>
          <TextBlock x:Name="statusLine" Margin="2,10,0,0" FontSize="12" Foreground="#6a6a64"
                     TextWrapping="Wrap" LineHeight="19"/>

          <UniformGrid Columns="3" Margin="0,10,0,0">
            <Border Background="#ffffff" BorderBrush="#e4e4de" BorderThickness="1" CornerRadius="8"
                    Margin="5" Padding="14,12">
              <StackPanel>
                <TextBlock Text="物理内存占用" Style="{StaticResource CardKey}"/>
                <TextBlock x:Name="cPct" Text="—" Style="{StaticResource CardVal}"/>
              </StackPanel>
            </Border>
            <Border Background="#ffffff" BorderBrush="#e4e4de" BorderThickness="1" CornerRadius="8"
                    Margin="5" Padding="14,12">
              <StackPanel>
                <TextBlock Text="可用内存（含待命）" Style="{StaticResource CardKey}"/>
                <TextBlock x:Name="cAvail" Text="—" Style="{StaticResource CardVal}"/>
              </StackPanel>
            </Border>
            <Border Background="#ffffff" BorderBrush="#e4e4de" BorderThickness="1" CornerRadius="8"
                    Margin="5" Padding="14,12">
              <StackPanel>
                <TextBlock Text="空闲 + 零页（真判据）" Style="{StaticResource CardKey}"/>
                <TextBlock x:Name="cFreeZero" Text="—" Style="{StaticResource CardVal}"/>
              </StackPanel>
            </Border>
            <Border Background="#ffffff" BorderBrush="#e4e4de" BorderThickness="1" CornerRadius="8"
                    Margin="5" Padding="14,12">
              <StackPanel>
                <TextBlock Text="待命列表（缓存页）" Style="{StaticResource CardKey}"/>
                <TextBlock x:Name="cStandby" Text="—" Style="{StaticResource CardVal}"/>
              </StackPanel>
            </Border>
            <Border Background="#ffffff" BorderBrush="#e4e4de" BorderThickness="1" CornerRadius="8"
                    Margin="5" Padding="14,12">
              <StackPanel>
                <TextBlock Text="系统缓存" Style="{StaticResource CardKey}"/>
                <TextBlock x:Name="cCache" Text="—" Style="{StaticResource CardVal}"/>
              </StackPanel>
            </Border>
            <Border Background="#ffffff" BorderBrush="#e4e4de" BorderThickness="1" CornerRadius="8"
                    Margin="5" Padding="14,12">
              <StackPanel>
                <TextBlock Text="提交额度" Style="{StaticResource CardKey}"/>
                <TextBlock x:Name="cCommit" Text="—" Style="{StaticResource CardVal}"/>
              </StackPanel>
            </Border>
            <Border Background="#ffffff" BorderBrush="#e4e4de" BorderThickness="1" CornerRadius="8"
                    Margin="5" Padding="14,12">
              <StackPanel>
                <TextBlock Text="硬缺页率（整理的代价）" Style="{StaticResource CardKey}"/>
                <TextBlock x:Name="cFault" Text="—" Style="{StaticResource CardVal}"/>
              </StackPanel>
            </Border>
            <Border Background="#ffffff" BorderBrush="#e4e4de" BorderThickness="1" CornerRadius="8"
                    Margin="5" Padding="14,12">
              <StackPanel>
                <TextBlock Text="已修改页" Style="{StaticResource CardKey}"/>
                <TextBlock x:Name="cModified" Text="—" Style="{StaticResource CardVal}"/>
              </StackPanel>
            </Border>
          </UniformGrid>

          <Border Background="#ffffff" BorderBrush="#e4e4de" BorderThickness="1" CornerRadius="8"
                  Margin="5,14,5,5" Padding="16,14">
            <StackPanel>
              <CheckBox x:Name="AutoChk" Content="自动整理：空闲 + 零页低于阈值时自动做一次轻度整理"
                        FontSize="12.5" Foreground="#3f3f3a" Cursor="Hand" Click="Auto_Click"/>
              <TextBlock x:Name="autoLine" Margin="0,8,0,0" FontSize="12" Foreground="#8b8b84"
                         TextWrapping="Wrap" LineHeight="19"/>
              <TextBlock Margin="0,6,0,0" FontSize="12" Foreground="#8b8b84" TextWrapping="Wrap"
                         LineHeight="19"
                         Text="自动整理只做免提权的轻度档（不会弹 UAC，也不会去清待命列表——那需要管理员，所以自动流程做不了）。"/>
            </StackPanel>
          </Border>

          </StackPanel>

        <!-- 进程表（M3）：表头可排序，搜框过滤，结束进程要先确认 -->
        <Border Grid.Row="1" Background="#ffffff" BorderBrush="#e4e4de" BorderThickness="1"
                CornerRadius="8" Margin="5,14,5,0" Padding="12,10">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="2,0,2,8">
              <TextBlock Text="进程" FontSize="13" FontWeight="SemiBold" Foreground="#4a4a46"
                         VerticalAlignment="Center"/>
              <TextBlock x:Name="procCount" FontSize="11.5" Foreground="#8b8b84"
                         VerticalAlignment="Center" Margin="44,0,0,0"/>
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBox x:Name="procSearch" Width="150" Height="26" FontSize="12"
                         VerticalContentAlignment="Center" Padding="6,0"
                         TextChanged="Search_TextChanged"
                         ToolTip="按进程名或 PID 过滤"/>
                <Button x:Name="BtnRefresh" Content="刷新" Style="{StaticResource ActBtn}" Height="26"
                        Margin="8,0,0,0" Padding="10,0" Click="Refresh_Click"/>
                <CheckBox x:Name="TreeChk" Content="连子孙" FontSize="12" Foreground="#3f3f3a"
                          VerticalAlignment="Center" Margin="10,0,0,0" Cursor="Hand"/>
                <Button x:Name="BtnKill" Content="结束进程" Style="{StaticResource ActBtn}" Height="26"
                        Margin="8,0,0,0" Padding="10,0" Click="Kill_Click"/>
              </StackPanel>
            </Grid>
            <DataGrid x:Name="procGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                      CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single"
                      HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#eeeeea" BorderThickness="0" Background="Transparent"
                      RowHeight="22" FontSize="12" Foreground="#4a4a46"
                      VerticalScrollBarVisibility="Auto" Sorting="Grid_Sorting">
              <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                  <Setter Property="Background" Value="#f2f2ee"/>
                  <Setter Property="Foreground" Value="#6a6a64"/>
                  <Setter Property="FontSize" Value="11.5"/>
                  <Setter Property="Padding" Value="6,3"/>
                  <Setter Property="BorderThickness" Value="0,0,0,1"/>
                  <Setter Property="BorderBrush" Value="#dcdcd6"/>
                  <Setter Property="HorizontalContentAlignment" Value="Left"/>
                </Style>
              </DataGrid.ColumnHeaderStyle>
              <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                  <Style.Triggers>
                    <!-- 受保护的（内核/关键进程）压暗：点了也会被采集端拒绝 -->
                    <DataTrigger Binding="{Binding Guarded}" Value="True">
                      <Setter Property="Foreground" Value="#b3b3ab"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </DataGrid.RowStyle>
              <DataGrid.Columns>
                <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="*"
                                    SortMemberPath="Name"/>
                <DataGridTextColumn Header="PID" Binding="{Binding Pid}" Width="70"
                                    SortMemberPath="Pid">
                  <DataGridTextColumn.ElementStyle>
                    <Style TargetType="TextBlock">
                      <Setter Property="HorizontalAlignment" Value="Right"/>
                    </Style>
                  </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="内存" Binding="{Binding MemText}" Width="90"
                                    SortMemberPath="MemMb">
                  <DataGridTextColumn.ElementStyle>
                    <Style TargetType="TextBlock">
                      <Setter Property="HorizontalAlignment" Value="Right"/>
                    </Style>
                  </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="CPU" Binding="{Binding CpuText}" Width="70"
                                    SortMemberPath="Cpu">
                  <DataGridTextColumn.ElementStyle>
                    <Style TargetType="TextBlock">
                      <Setter Property="HorizontalAlignment" Value="Right"/>
                    </Style>
                  </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="线程" Binding="{Binding Threads}" Width="60"
                                    SortMemberPath="Threads">
                  <DataGridTextColumn.ElementStyle>
                    <Style TargetType="TextBlock">
                      <Setter Property="HorizontalAlignment" Value="Right"/>
                    </Style>
                  </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
              </DataGrid.Columns>
            </DataGrid>
          </Grid>
        </Border>

        <Border Grid.Row="2" Background="#ffffff" BorderBrush="#e4e4de" BorderThickness="1"
                CornerRadius="8" Margin="5,10,5,0" Padding="14,10">
          <StackPanel>
            <TextBlock x:Name="lastResult" FontSize="12.5" Foreground="#4a4a46"
                       TextWrapping="Wrap" LineHeight="19" Text="还没整理过。"/>
            <TextBlock Margin="0,6,0,0" FontSize="11.5" Foreground="#8b8b84" TextWrapping="Wrap"
                       LineHeight="17"
                       Text="“搬走”不等于“腾出”：清掉的工作集/缓存页会在下次访问时从 pagefile 硬缺页读回；available 把待命列表算作可用，清完它几乎不动——要看效果请看“空闲 + 零页”。"/>
          </StackPanel>
        </Border>
      </Grid>
    </Grid>
  </Border>
</Window>