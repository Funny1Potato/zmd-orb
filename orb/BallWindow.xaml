<Window x:Class="ZmdOrb.BallWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ZmdOrb"
        Title="zmd-orb"
        Width="180" Height="180" Left="1200" Top="220"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" Topmost="True" ShowInTaskbar="False" ShowActivated="False"
        WindowStartupLocation="Manual" UseLayoutRounding="True" SnapsToDevicePixels="True"
        FontFamily="Segoe UI, Microsoft YaHei" TextOptions.TextFormattingMode="Ideal">

  <!-- 透明底 + 分层窗口：窗口移动由 DWM 直接合成，不再触发内容重绘，
       也就没有 WebView2 那套"移动/切焦点后 alpha 丢失泛底"的问题。
       分层窗口按像素 alpha 命中测试，四角的透明像素自动点击穿透，不需要 SetWindowRgn。

       窗口 180、内容（Stage）160 居中：给点击时的放大留 10px 余量，
       否则 1.09 倍会让装饰弧顶到窗口边缘被裁一条（悬停 1.05 倍也一样）。 -->
  <Grid x:Name="Stage" Width="160" Height="160" Background="Transparent" RenderTransformOrigin="0.5,0.5"
        HorizontalAlignment="Center" VerticalAlignment="Center"
        MouseEnter="Stage_MouseEnter" MouseLeave="Stage_MouseLeave"
        MouseLeftButtonDown="Stage_MouseLeftButtonDown" MouseLeftButtonUp="Stage_MouseLeftButtonUp"
        MouseMove="Stage_MouseMove">

    <Grid.RenderTransform>
      <ScaleTransform x:Name="StageScale" ScaleX="1" ScaleY="1"/>
    </Grid.RenderTransform>

    <!-- 右键菜单（M4）：打开面板 / 轻度整理 / 轻量模式 / 切到托盘模式 / 退出
         （属性元素要写在内容之前；Opened 用来把"轻量模式"的勾对齐当前设置——面板里也能改它） -->
    <Grid.ContextMenu>
      <ContextMenu x:Name="BallMenu" FontSize="12.5" FontFamily="Segoe UI, Microsoft YaHei"
                   Opened="Menu_Opened">
        <MenuItem Header="打开面板" Click="Menu_Panel"/>
        <MenuItem Header="轻度整理（免提权）" Click="Menu_Clean"/>
        <Separator/>
        <MenuItem x:Name="miLite" Header="轻量模式" IsCheckable="True" Click="Menu_Lite"
                  ToolTip="省内存与 CPU：球面更素净，静止时不再持续重画。勾上或取消都会重启一次才生效"/>
        <MenuItem Header="切到托盘模式" Click="Menu_Mode"/>
        <Separator/>
        <MenuItem Header="退出" Click="Menu_Quit"/>
      </ContextMenu>
    </Grid.ContextMenu>

    <local:BallVisual x:Name="Visual"/>

    <TextBlock x:Name="PctText" VerticalAlignment="Center" HorizontalAlignment="Center"
               IsHitTestVisible="False" Foreground="#4a4a46"
               FontSize="36" FontWeight="SemiBold" TextAlignment="Center"
               LineHeight="36" LineStackingStrategy="BlockLineHeight"><Run x:Name="PctNum" Text="—"/><Run x:Name="PctSign" Text="%" FontSize="15"/></TextBlock>

    <Border x:Name="FloatBox" VerticalAlignment="Top" HorizontalAlignment="Center"
            Margin="0,18,0,0" Opacity="0" IsHitTestVisible="False"
            Background="#e62c2c2a" CornerRadius="7" Padding="7,3">
      <Border.RenderTransform>
        <TranslateTransform x:Name="FloatShift" Y="4"/>
      </Border.RenderTransform>
      <TextBlock x:Name="FloatText" HorizontalAlignment="Center" FontSize="12" FontWeight="SemiBold"
                 Foreground="#ffe9a8" TextAlignment="Center" LineHeight="14"
                 LineStackingStrategy="BlockLineHeight"/>
    </Border>
  </Grid>
</Window>