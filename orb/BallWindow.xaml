<Window x:Class="ZmdOrb.BallWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ZmdOrb"
        Title="zmd-orb"
        Width="160" Height="160" Left="1200" Top="220"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" Topmost="True" ShowInTaskbar="False" ShowActivated="False"
        WindowStartupLocation="Manual" UseLayoutRounding="True" SnapsToDevicePixels="True"
        FontFamily="Segoe UI, Microsoft YaHei" TextOptions.TextFormattingMode="Ideal">

  <!-- 透明底 + 分层窗口：窗口移动由 DWM 直接合成，不再触发内容重绘，
       也就没有 WebView2 那套"移动/切焦点后 alpha 丢失泛底"的问题。
       分层窗口按像素 alpha 命中测试，四角的透明像素自动点击穿透，不需要 SetWindowRgn。 -->
  <Grid x:Name="Stage" Background="Transparent" RenderTransformOrigin="0.5,0.5"
        MouseEnter="Stage_MouseEnter" MouseLeave="Stage_MouseLeave"
        MouseLeftButtonDown="Stage_MouseLeftButtonDown" MouseLeftButtonUp="Stage_MouseLeftButtonUp"
        MouseMove="Stage_MouseMove" MouseRightButtonUp="Stage_MouseRightButtonUp">

    <Grid.RenderTransform>
      <ScaleTransform x:Name="StageScale" ScaleX="1" ScaleY="1"/>
    </Grid.RenderTransform>

    <local:BallVisual x:Name="Visual"/>

    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False">
      <TextBlock x:Name="PctText" HorizontalAlignment="Center" Foreground="#4a4a46"
                 FontSize="29" FontWeight="SemiBold" TextAlignment="Center"
                 LineHeight="29" LineStackingStrategy="BlockLineHeight"><Run x:Name="PctNum" Text="—"/><Run x:Name="PctSign" Text="%" FontSize="13"/></TextBlock>
      <TextBlock x:Name="SubText" HorizontalAlignment="Center" Margin="0,4,0,0"
                 FontSize="10" Foreground="#7b7b74" TextAlignment="Center"
                 LineHeight="12" LineStackingStrategy="BlockLineHeight"/>
    </StackPanel>

    <TextBlock x:Name="FloatText" VerticalAlignment="Top" HorizontalAlignment="Center"
               Margin="0,26,0,0" FontSize="11" FontWeight="SemiBold" Foreground="#8a7a2a"
               Opacity="0" IsHitTestVisible="False">
      <TextBlock.RenderTransform>
        <TranslateTransform x:Name="FloatShift" Y="4"/>
      </TextBlock.RenderTransform>
    </TextBlock>
  </Grid>
</Window>